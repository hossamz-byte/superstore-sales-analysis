                <story-points>
                  <story-point caption='Superstore Sales 2015–2018: What Drives Our Revenue?' captured-sheet='Superstore sales dashboard' id='1' />
                  <story-point caption='Recap Of our &#10;Total sales,orders,customers and AOV' captured-sheet='Cards' id='5' />
                  <story-point caption='Sales fell 4.2% in 2016, then grew 30.6% in 2017 and 20.3% in 2018, reaching 722K.' captured-sheet='year by year growth' id='2' />
                  <story-point caption='West and East make up 61% of sales. California, New York and Texas are 40.7%.' captured-sheet='Map Sales' id='4'>
                    <capturedDeltas>
                      <worksheet name='Map Sales'>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <encoding attr='space' class='0' field='[federated.0xjborn1b0jx4810auvav1n9ca1h].[Latitude (generated)]' field-type='quantitative' max='6363321.4077874543' min='1973375.4928809986' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                            <encoding attr='space' class='0' field='[federated.0xjborn1b0jx4810auvav1n9ca1h].[Longitude (generated)]' field-type='quantitative' max='-6085038.1589741213' min='-15606343.349044625' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                          </style-rule>
                        </style>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Sales rise in all three categories. Q4 2018 peaked at 104K (Technology), 90K (Furniture) and 84K (Office Supplies). The 2019 forecast is flat with wide ranges, so treat it as a rough estimate.' captured-sheet='Forecast 2019' id='7' />
                  <story-point caption='Technology brings 36.6% of sales. Furniture 32.2%, Office Supplies 31.2%.' captured-sheet='category vs sales' id='3' />
                </story-points>
